<?xml version='1.0' encoding='utf-8'?>
<robot name="differential_drive_robot">
  <!--SI units. base_link: drive axle centre. lidar_link: optical scan centre. Visual STL vertices are already in metres and link-local coordinates.-->
  <material name="silver">
    <color rgba="0.65 0.67 0.70 1" />
  </material>
  <material name="rubber">
    <color rgba="0.035 0.035 0.04 1" />
  </material>
  <material name="black">
    <color rgba="0.09 0.095 0.105 1" />
  </material>
  <material name="window">
    <color rgba="0.025 0.075 0.13 1" />
  </material>
  <link name="base_link">
    <visual name="base_link_chassis_enclosure">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/base_link_chassis_enclosure.stl" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision name="chassis_collision">
      <origin xyz="0.09 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.24 0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.09 0 0.0275" rpy="0 0 0" />
      <mass value="4" />
      <inertia ixx="0.0206002861959" ixy="0" ixz="0" iyy="0.0289253875086" iyz="0" izz="0.0406867350159" />
    </inertial>
  </link>
  <link name="left_wheel_link">
    <visual name="left_wheel_link_rubber_wheel">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/left_wheel_link_rubber_wheel.stl" scale="1 1 1" />
      </geometry>
      <material name="rubber" />
    </visual>
    <visual name="left_wheel_link_outer_hub">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/left_wheel_link_outer_hub.stl" scale="1 1 1" />
      </geometry>
      <material name="black" />
    </visual>
    <visual name="left_wheel_link_axle_cap">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/left_wheel_link_axle_cap.stl" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision name="wheel_collision">
      <origin xyz="0 0 0" rpy="1.570796327 0 0" />
      <geometry>
        <cylinder radius="0.075" length="0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.35" />
      <inertia ixx="0.0005184375" ixy="0" ixz="0" iyy="0.000984375" iyz="0" izz="0.0005184375" />
    </inertial>
  </link>
  <link name="right_wheel_link">
    <visual name="right_wheel_link_rubber_wheel">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/right_wheel_link_rubber_wheel.stl" scale="1 1 1" />
      </geometry>
      <material name="rubber" />
    </visual>
    <visual name="right_wheel_link_outer_hub">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/right_wheel_link_outer_hub.stl" scale="1 1 1" />
      </geometry>
      <material name="black" />
    </visual>
    <visual name="right_wheel_link_axle_cap">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/right_wheel_link_axle_cap.stl" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision name="wheel_collision">
      <origin xyz="0 0 0" rpy="1.570796327 0 0" />
      <geometry>
        <cylinder radius="0.075" length="0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.35" />
      <inertia ixx="0.0005184375" ixy="0" ixz="0" iyy="0.000984375" iyz="0" izz="0.0005184375" />
    </inertial>
  </link>
  <link name="caster_fork_link">
    <visual name="caster_fork_link_swivel_plate">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/caster_fork_link_swivel_plate.stl" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <visual name="caster_fork_link_fork_left">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/caster_fork_link_fork_left.stl" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <visual name="caster_fork_link_fork_right">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/caster_fork_link_fork_right.stl" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision name="swivel_plate_collision">
      <origin xyz="0 0 -0.0015" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.022" length="0.003" />
      </geometry>
    </collision>
    <collision name="fork_left_collision">
      <origin xyz="-0.0075 0.012 -0.022" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.004 0.038" />
      </geometry>
    </collision>
    <collision name="fork_right_collision">
      <origin xyz="-0.0075 -0.012 -0.022" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.004 0.038" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.005 0 -0.017" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="3.617e-05" ixy="0" ixz="0" iyy="3.617e-05" iyz="0" izz="3.872e-05" />
    </inertial>
  </link>
  <link name="caster_wheel_link">
    <visual name="caster_wheel_link_caster_tyre">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/caster_wheel_link_caster_tyre.stl" scale="1 1 1" />
      </geometry>
      <material name="rubber" />
    </visual>
    <visual name="caster_wheel_link_caster_axle">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/caster_wheel_link_caster_axle.stl" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision name="caster_collision">
      <origin xyz="0 0 0" rpy="1.570796327 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.018" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="1.466e-05" ixy="0" ixz="0" iyy="2.5e-05" iyz="0" izz="1.466e-05" />
    </inertial>
  </link>
  <link name="lidar_link">
    <visual name="lidar_link_lidar_mount">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/lidar_link_lidar_mount.stl" scale="1 1 1" />
      </geometry>
      <material name="black" />
    </visual>
    <visual name="lidar_link_lidar_lower_housing">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/lidar_link_lidar_lower_housing.stl" scale="1 1 1" />
      </geometry>
      <material name="black" />
    </visual>
    <visual name="lidar_link_lidar_optical_window">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/lidar_link_lidar_optical_window.stl" scale="1 1 1" />
      </geometry>
      <material name="window" />
    </visual>
    <visual name="lidar_link_lidar_cap">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://differential_drive_robot_description/meshes/lidar_link_lidar_cap.stl" scale="1 1 1" />
      </geometry>
      <material name="black" />
    </visual>
    <collision name="housing_collision">
      <origin xyz="0 0 -0.0075" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.06" />
      </geometry>
    </collision>
    <collision name="mount_collision">
      <origin xyz="0 0 -0.039" rpy="0 0 0" />
      <geometry>
        <box size="0.09 0.09 0.003" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.0075" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.00014" iyz="0" izz="0.00016" />
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0 0.145 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="2.0" velocity="20" />
    <dynamics damping="0.001" friction="0" />
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0 -0.145 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="2.0" velocity="20" />
    <dynamics damping="0.001" friction="0" />
  </joint>
  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link" />
    <child link="caster_fork_link" />
    <origin xyz="0.2 0 -0.01" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="0.3" velocity="100" />
    <dynamics damping="0.0001" friction="0" />
  </joint>
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_fork_link" />
    <child link="caster_wheel_link" />
    <origin xyz="-0.015 0 -0.04" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="0.3" velocity="100" />
    <dynamics damping="0.0001" friction="0" />
  </joint>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.09 0 0.1305" rpy="0 0 0" />
  </joint>
  <gazebo reference="base_link">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <selfCollide>false</selfCollide>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <selfCollide>false</selfCollide>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster_fork_link">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="caster_wheel_link">
    <selfCollide>false</selfCollide>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="lidar_link">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>.29</wheel_separation>
      <wheel_radius>.075</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>caster_swivel_joint</joint_name>
      <joint_name>caster_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.12413936106985</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>.12</min>
          <max>10</max>
          <resolution>.01</resolution>
        </range>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>